<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Low Attendance Alerts</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container">
        <h1 class="mb-4">Low Attendance Alerts</h1>
        
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card border-danger shadow-sm h-100">
                    <div class="card-header bg-danger text-white">
                        <h5 class="card-title mb-0">Danger Zone (Under 75%)</h5>
                    </div>
                    <ul class="list-group list-group-flush">
                        <% if (dangerZone.length === 0) { %>
                            <li class="list-group-item text-muted">No subjects in the danger zone. You're safe!</li>
                        <% } %>
                        <% dangerZone.forEach(item => { %>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <%= item.subjectName %>
                                <span class="badge bg-danger rounded-pill"><%= item.percentage %>%</span>
                            </li>
                        <% }); %>
                    </ul>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card border-success shadow-sm h-100">
                    <div class="card-header bg-success text-white">
                        <h5 class="card-title mb-0">Safe Zone (Over 75%)</h5>
                    </div>
                    <ul class="list-group list-group-flush">
                        <% if (safeZone.length === 0) { %>
                            <li class="list-group-item text-muted">No subjects in the safe zone. Start attending classes!</li>
                        <% } %>
                        <% safeZone.forEach(item => { %>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <%= item.subjectName %>
                                <span class="badge bg-success rounded-pill"><%= item.percentage %>%</span>
                            </li>
                        <% }); %>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
