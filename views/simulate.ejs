<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>What-If Calculator</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container">
        <h1 class="mb-4">What-If Calculator</h1>
        <div class="row">
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <form id="calculatorForm">
                            <div class="mb-3">
                                <label for="subjectSelect" class="form-label">Select Subject</label>
                                <select class="form-select" id="subjectSelect">
                                    <option value="" disabled selected>Choose...</option>
                                    <% attendance.forEach(item => { %>
                                        <option value="<%= JSON.stringify(item) %>"><%= item.subjectName %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="missedClasses" class="form-label">Future Missed Classes</label>
                                <input type="number" class="form-control" id="missedClasses" min="0" value="0">
                            </div>
                            <button type="button" class="btn btn-primary" onclick="calculateDrop()">Calculate</button>
                        </form>
                    </div>
                </div>
            </div>
            
            <div class="col-md-6 mt-4 mt-md-0">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-info text-white">
                        <h5 class="card-title mb-0">Projected Result</h5>
                    </div>
                    <div class="card-body d-flex flex-column justify-content-center align-items-center" id="resultArea">
                        <h4 class="text-muted">Select a subject to simulate.</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function calculateDrop() {
            const select = document.getElementById('subjectSelect');
            const missedInput = document.getElementById('missedClasses');
            const resultArea = document.getElementById('resultArea');

            if (!select.value) {
                alert("Please select a subject.");
                return;
            }

            const item = JSON.parse(select.value);
            const missed = parseInt(missedInput.value) || 0;

            const newConducted = item.conducted + missed;
            const newPresent = item.present;
            const newPercentage = (newPresent / newConducted) * 100;
            const oldPercentage = (item.present / item.conducted) * 100;

            let statusClass = 'text-success';
            if (newPercentage < 75) statusClass = 'text-danger';
            else if (newPercentage < 80) statusClass = 'text-warning';

            resultArea.innerHTML = `
                <h5>${item.subjectName}</h5>
                <p>Old Percentage: <strong>${oldPercentage.toFixed(1)}%</strong></p>
                <h2 class="${statusClass}">New Projected Percentage: ${newPercentage.toFixed(1)}%</h2>
                <p class="text-muted">Conducted: ${newConducted} | Present: ${newPresent}</p>
            `;
        }
    </script>
</body>
</html>
