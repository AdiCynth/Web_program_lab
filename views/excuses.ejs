<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alibi Log</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container">
        <h1 class="mb-4">Alibi Log</h1>
        
        <% if (message) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="row">
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="card-title mb-0">Submit a New Excuse</h5>
                    </div>
                    <div class="card-body">
                        <form action="/excuses" method="POST">
                            <div class="mb-3">
                                <label for="subjectSelect" class="form-label">Subject</label>
                                <select class="form-select" id="subjectSelect" name="subjectName" required>
                                    <option value="" disabled selected>Choose...</option>
                                    <% attendance.forEach(item => { %>
                                        <option value="<%= item.subjectName %>"><%= item.subjectName %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="excuseText" class="form-label">Alibi / Excuse</label>
                                <textarea class="form-control" id="excuseText" name="excuse" rows="3" required placeholder="e.g. Train was late..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">Log Alibi</button>
                        </form>
                    </div>
                </div>
            </div>
            
            <div class="col-md-6 mt-4 mt-md-0">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-dark text-white">
                        <h5 class="card-title mb-0">Recorded Alibis (DB)</h5>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            <% attendance.forEach(item => { %>
                                <% if (item.excuseLog && item.excuseLog.length > 0) { %>
                                    <li class="list-group-item">
                                        <strong><%= item.subjectName %></strong>
                                        <ul class="mt-2 text-muted">
                                            <% item.excuseLog.forEach(log => { %>
                                                <li><%= log %></li>
                                            <% }); %>
                                        </ul>
                                    </li>
                                <% } %>
                            <% }); %>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
